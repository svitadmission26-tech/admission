{
	"compilerOptions": {
		"allowJs": true,
		"checkJs": false,
		"esModuleInterop": true,
		"forceConsistentCasingInFileNames": true,
		"resolveJsonModule": true,
		"skipLibCheck": true,
		"noEmit": true,
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"target": "ES2022",
		"jsx": "react-jsx",
		"lib": ["ES2022", "DOM", "DOM.Iterable"]
	},
	"include": ["src/main.jsx", "src/supabase.js", "vite.config.ts"],
	"exclude": ["node_modules"]
}